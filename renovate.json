{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":timezone(Europe/Vienna)",
    "schedule:weekly",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "minimumReleaseAge": "3 days",
  "prHourlyLimit": 0,
  "automergeStrategy": "merge-commit",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"]
  }
}
