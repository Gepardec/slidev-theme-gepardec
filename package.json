{
  "name": "slidev-theme-gepardec",
  "version": "0.0.0",
  "type": "module",
  "description": "Gepardec-branded Slidev theme — black background, gepardec yellow accents, italic condensed typography, // bullet markers.",
  "keywords": [
    "slidev-theme",
    "slidev",
    "gepardec"
  ],
  "author": "Gepardec IT Services GmbH",
  "license": "MIT",
  "engines": {
    "node": ">=20.12.0",
    "slidev": ">=0.49.0"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@slidev/types": "^52.16.0"
  },
  "devDependencies": {
    "@slidev/cli": "^52.16.0"
  },
  "//": "Learn more: https://sli.dev/guide/write-theme.html",
  "slidev": {
    "colorSchema": "dark",
    "defaults": {
      "fonts": {
        "sans": "Barlow Semi Condensed",
        "mono": "JetBrains Mono",
        "italic": true
      },
      "highlighter": "shiki"
    }
  }
}